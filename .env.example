# ============================================
# COOPERATIVA EL TRIUNFO - VARIABLES DE ENTORNO
# ============================================
# Copiar este archivo a .env y configurar con valores reales
# ⚠️ NUNCA commitear el archivo .env al repositorio
# ============================================

# ============================================
# ENTORNO
# ============================================
NODE_ENV=development
# Opciones: development, staging, production

# ============================================
# BACKEND - API
# ============================================
PORT=5000
API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# ============================================
# BASE DE DATOS - POSTGRESQL
# ============================================
DATABASE_URL="postgresql://cooperativa_user:password_seguro@localhost:5432/cooperativa_dev?schema=public"
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA

# Para producción usar:
# DATABASE_URL="postgresql://cooperativa_prod:STRONG_PASSWORD@db.example.com:5432/cooperativa_prod?schema=public&connection_limit=10&pool_timeout=20"

# ============================================
# AUTENTICACIÓN - JWT
# ============================================
JWT_SECRET=CAMBIAR_ESTO_POR_SECRETO_FUERTE_MINIMO_32_CARACTERES
JWT_EXPIRES_IN=8h
# Expiración del token: 1h, 8h, 1d, 7d

JWT_REFRESH_SECRET=CAMBIAR_ESTO_POR_OTRO_SECRETO_DIFERENTE_AL_ANTERIOR
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# SEGURIDAD
# ============================================
BCRYPT_SALT_ROUNDS=12
# Número de rondas para hash de passwords (10-12 recomendado)

CORS_ORIGIN=http://localhost:3000
# En producción: https://cooperativa.example.com

RATE_LIMIT_WINDOW_MS=900000
# 15 minutos en milisegundos
RATE_LIMIT_MAX_REQUESTS=100
# Máximo de requests por ventana de tiempo

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=debug
# Opciones: error, warn, info, http, verbose, debug, silly

LOG_FILE_PATH=./logs/app.log
LOG_ERROR_FILE_PATH=./logs/error.log

# ============================================
# MIGRACIÓN DE DATOS (Sistema Viejo)
# ============================================
OLD_SYSTEM_DB_HOST=cooptriunfo.org
OLD_SYSTEM_DB_PORT=5432
OLD_SYSTEM_DB_NAME=cooperativa_viejo
OLD_SYSTEM_DB_USER=readonly_user
OLD_SYSTEM_DB_PASSWORD=SOLICITAR_AL_CLIENTE
# ⚠️ Solo lectura para scripts de migración

# ============================================
# INTEGRACIONES - BANCARIAS (Opcional)
# ============================================
BANCO_API_URL=https://api.banco.example.com
BANCO_API_KEY=SOLICITAR_AL_BANCO
BANCO_WEBHOOK_SECRET=SOLICITAR_AL_BANCO
# Si no hay integración, dejar vacío

# ============================================
# NOTIFICACIONES - EMAIL (Opcional)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notificaciones@cooperativa.com
SMTP_PASSWORD=SOLICITAR_AL_ADMIN
SMTP_FROM=Sistema Cooperativa <notificaciones@cooperativa.com>

# ============================================
# NOTIFICACIONES - SMS (Opcional)
# ============================================
SMS_PROVIDER=twilio
# Opciones: twilio, nexmo, etc.
SMS_ACCOUNT_SID=SOLICITAR_A_TWILIO
SMS_AUTH_TOKEN=SOLICITAR_A_TWILIO
SMS_FROM_NUMBER=+18095551234

# ============================================
# ALMACENAMIENTO DE ARCHIVOS
# ============================================
UPLOAD_MAX_SIZE_MB=10
# Tamaño máximo de archivos subidos (MB)

STORAGE_TYPE=local
# Opciones: local, s3, azure
# Si local:
STORAGE_PATH=./uploads

# Si S3:
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=SOLICITAR_AWS
# AWS_SECRET_ACCESS_KEY=SOLICITAR_AWS
# AWS_S3_BUCKET=cooperativa-uploads

# ============================================
# REDIS (Opcional - para caching y sessions)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Dejar vacío si no tiene password
REDIS_DB=0

# ============================================
# MONITOREO Y ANALYTICS (Opcional)
# ============================================
SENTRY_DSN=
# Para error tracking en producción
# https://sentry.io/

ANALYTICS_ENABLED=false
# Google Analytics o similar

# ============================================
# PARÁMETROS DE NEGOCIO (Configurables)
# ============================================
TASA_DIVISA_INICIAL=700.22
# Tasa Bs/USD inicial (se puede cambiar desde el admin)

SEMANAS_SUSPENSION_FUNERARIA=6
# Semanas sin pago para suspensión automática en funeraria

SEMANAS_SUSPENSION_SALUD=11
# Semanas sin pago para suspensión automática en salud

PORCENTAJE_MINIMO_AHORRO_FIADOR=30
# % del préstamo que debe tener disponible el fiador

MAX_FIADORES=2
# Máximo de fiadores por préstamo

# ============================================
# DESARROLLO Y DEBUG
# ============================================
DEBUG=false
# Mostrar logs detallados de queries DB

SEED_DATABASE=false
# Cargar datos de prueba al iniciar (solo development)

SKIP_AUTH_IN_DEV=false
# ⚠️ PELIGROSO: Saltar autenticación en desarrollo

# ============================================
# TESTING
# ============================================
TEST_DATABASE_URL="postgresql://cooperativa_user:password_seguro@localhost:5432/cooperativa_test?schema=public"
# Base de datos separada para tests

# ============================================
# FRONTEND (React) - Variables que empiezan con VITE_
# ============================================
VITE_API_URL=http://localhost:5000/api
VITE_APP_NAME=Cooperativa el Triunfo
VITE_APP_VERSION=1.0.0
VITE_ENABLE_DEV_TOOLS=true
# React Query DevTools, etc.

# ============================================
# JOBS Y CRON
# ============================================
ENABLE_CRON_JOBS=true
# Habilitar jobs programados

CRON_CALCULAR_SUSPENSIONES=0 2 * * *
# Todos los días a las 2 AM (formato cron)

CRON_BACKUP_DB=0 3 * * *
# Todos los días a las 3 AM

CRON_LIMPIAR_LOGS_VIEJOS=0 4 * * 0
# Todos los domingos a las 4 AM

# ============================================
# NOTAS
# ============================================
# 1. NUNCA commitear este archivo con valores reales
# 2. Agregar .env al .gitignore
# 3. Usar secretos fuertes en producción (mínimo 32 caracteres aleatorios)
# 4. Rotar secrets cada 90 días en producción
# 5. Usar Azure Key Vault o AWS Secrets Manager para producción
# ============================================
