// ============================================
// COOPERATIVA EL TRIUNFO - PRISMA SCHEMA
// ============================================
// Esquema de base de datos completo
// PostgreSQL 16+
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// AUTENTICACIÓN Y USUARIOS
// ============================================

model Usuario {
  id              Int           @id @default(autoincrement())
  username        String        @unique @db.VarChar(50)
  email           String?       @unique @db.VarChar(100)
  password_hash   String        @db.VarChar(255)
  nombre_completo String        @db.VarChar(150)
  rol_id          Int
  estado          EstadoUsuario @default(activo)
  ultimo_acceso   DateTime?
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt

  // Relaciones
  rol                Rol                @relation(fields: [rol_id], references: [id])
  colectas           Colecta[]          @relation("UsuarioColecta")
  cierres_caja       CierreCaja[]
  movimientos_boveda MovimientoBoveda[]
  audit_logs         AuditLog[]

  @@map("usuarios")
}

model Rol {
  id          Int      @id @default(autoincrement())
  nombre      String   @unique @db.VarChar(50)
  descripcion String?  @db.Text
  permisos    Json // Array de permisos: [{modulo: 'socios', accion: 'read'}]
  created_at  DateTime @default(now())

  // Relaciones
  usuarios Usuario[]

  @@map("roles")
}

enum EstadoUsuario {
  activo
  inactivo
  bloqueado
}

// ============================================
// SOCIOS Y BENEFICIARIOS
// ============================================

model Socio {
  id                Int         @id @default(autoincrement())
  codigo_socio      String      @unique @db.VarChar(20) // Expediente/Número de socio (manual, único)
  cedula            String      @db.VarChar(11) // Sin guiones: 01234567890
  nombre            String      @db.VarChar(100)
  apellido          String      @db.VarChar(100)
  sexo              Sexo? // M = Masculino, F = Femenino
  fecha_nacimiento  DateTime?   @db.Date
  direccion         String?     @db.Text
  telefono          String?     @db.VarChar(100) // Aumentado para múltiples teléfonos
  email             String?     @db.VarChar(100)
  fecha_inscripcion DateTime    @db.Date
  estado            EstadoSocio @default(activo)
  es_delegado       Boolean     @default(false)
  // OBSOLETO desde la fase 2: no se lee ni se actualiza. Si el socio también es
  // trabajador se sabe por su persona (expediente en socios_trabajadores sin
  // retirar). Queda para no perder el dato migrado; puede borrarse más adelante.
  es_trabajador     Boolean     @default(false)
  ubicacion_id      Int?
  // Identidad de la persona (fase 2). Nulo hasta correr prisma/backfill-personas.ts
  persona_id        Int?
  foto_url          String?     @db.VarChar(255) // URL antigua (deprecado)
  foto              Bytes? // Foto del socio almacenada como BLOB
  autorizado_nombre String?     @db.VarChar(100) // Persona que autoriza al socio
  autorizado_cedula String?     @db.VarChar(11) // Cédula del autorizado
  codigo_social     String?     @db.VarChar(30) // Código de programas sociales
  notas             String?     @db.Text // Historial y observaciones
  created_at        DateTime    @default(now())
  updated_at        DateTime    @updatedAt

  // Relaciones
  ubicacion             Ubicacion?           @relation(fields: [ubicacion_id], references: [id])
  persona               Persona?             @relation(fields: [persona_id], references: [id])
  beneficiarios         Beneficiario[]
  cuentas_ahorro        CuentaAhorro[]
  prestamos             Prestamo[]           @relation("SocioPrestamo")
  prestamos_como_fiador Fiador[]
  usuario_digital       UsuarioDigital?
  asistencias_asamblea  AsistenciaAsamblea[]
  colectas              Colecta[]

  @@index([cedula])
  @@index([codigo_socio])
  @@index([nombre, apellido])
  @@index([ubicacion_id])
  @@index([estado])
  @@index([persona_id])
  @@map("socios")
}

model Beneficiario {
  id                  Int                @id @default(autoincrement())
  socio_id            Int
  cedula              String             @unique @db.VarChar(11)
  nombre              String             @db.VarChar(100)
  apellido            String             @db.VarChar(100)
  fecha_nacimiento    DateTime?          @db.Date
  fecha_ingreso       DateTime?          @db.Date
  parentesco          String             @db.VarChar(50) // hijo, cónyuge, padre, madre, etc.
  telefono            String?            @db.VarChar(100)
  estado              EstadoBeneficiario @default(activo)
  fecha_fallecimiento DateTime?          @db.Date
  created_at          DateTime           @default(now())
  updated_at          DateTime           @updatedAt

  // Relaciones
  socio              Socio              @relation(fields: [socio_id], references: [id], onDelete: Cascade)
  acuerdos_funeraria AcuerdoFuneraria[]
  acuerdos_salud     AcuerdoSalud[]

  @@index([socio_id])
  @@index([cedula])
  @@map("beneficiarios")
}

enum EstadoSocio {
  activo
  retirado
  invalido
}

enum EstadoBeneficiario {
  activo
  inactivo
  retirado
  fallecido
}

enum Sexo {
  M // Masculino
  F // Femenino
}

// ============================================
// PERSONAS Y EXPEDIENTES (fase 2)
// ============================================
//
// Persona ≠ expediente. La persona guarda la identidad; cada rol en la
// cooperativa es un expediente aparte, con sus propios movimientos, fechas y
// estado. `Socio` sigue siendo el expediente AHORRISTA (no se renombró para no
// tocar lo que ya está en producción) y `SocioTrabajador` es el expediente de
// quien trabaja en una feria.
//
// OJO: la migración crea dos índices únicos PARCIALES y dos CHECK que Prisma no
// sabe expresar, así que no figuran aquí. Prisma los ignora al comparar, pero
// si alguien regenera la migración desde el schema se pierden. Ver
// 20260913000000_personas_trabajadores.

model Persona {
  id                    Int                @id @default(autoincrement())
  tipo_identificacion   TipoIdentificacion @default(V)
  // Cédula en dígitos (mismo criterio que socios.cedula); pasaporte o RIF tal cual
  numero_identificacion String             @unique @db.VarChar(20)
  nombres               String             @db.VarChar(100)
  apellidos             String             @db.VarChar(100)
  sexo                  Sexo?
  fecha_nacimiento      DateTime?          @db.Date
  telefono              String?            @db.VarChar(100)
  email                 String?            @db.VarChar(100)
  direccion             String?            @db.Text
  estado                EstadoPersona      @default(activo)
  created_by            Int?
  created_at            DateTime           @default(now())
  updated_at            DateTime           @updatedAt

  // Relaciones
  socios       Socio[]
  trabajadores SocioTrabajador[]

  @@index([apellidos, nombres])
  @@map("personas")
}

model SocioTrabajador {
  id                Int              @id @default(autoincrement())
  persona_id        Int
  codigo_trabajador String           @unique @db.VarChar(20)
  // Inicio laboral: de aquí sale el fin del período de prueba
  fecha_ingreso     DateTime         @db.Date
  estado            EstadoTrabajador @default(activo)
  fecha_salida      DateTime?        @db.Date
  motivo_salida     String?          @db.Text
  observaciones     String?          @db.Text
  created_by        Int?
  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt

  // Relaciones
  persona     Persona               @relation(fields: [persona_id], references: [id])
  ferias      TrabajadorFeria[]
  pagos_salud PagoSaludTrabajador[]

  // Parcial en la migración: una persona no tiene dos expedientes sin retirar
  @@index([persona_id])
  @@index([estado])
  @@map("socios_trabajadores")
}

/// Historial de ferias del trabajador. La asociación actual es la que tiene
/// `fecha_fin` nula; cambiar de feria la cierra y abre otra, nunca la pisa.
model TrabajadorFeria {
  id            Int       @id @default(autoincrement())
  trabajador_id Int
  feria_id      Int
  fecha_inicio  DateTime  @db.Date
  fecha_fin     DateTime? @db.Date
  motivo_cambio String?   @db.Text
  created_by    Int?
  created_at    DateTime  @default(now())

  // Relaciones
  trabajador SocioTrabajador @relation(fields: [trabajador_id], references: [id])
  feria      Ubicacion       @relation(fields: [feria_id], references: [id])

  // Parcial en la migración: una sola asociación abierta por trabajador (QA-FIN-06)
  @@index([trabajador_id])
  @@index([feria_id])
  @@map("trabajador_feria")
}

enum TipoIdentificacion {
  V // Venezolano
  E // Extranjero
  J // Jurídico (RIF)
  P // Pasaporte
}

enum EstadoPersona {
  activo
  inactivo
  fallecido
}

enum EstadoTrabajador {
  activo
  suspendido
  retirado
  inactivo
}

// ============================================
// PAGO DE SALUD POR FERIA (fase 2)
// ============================================
//
// La feria descuenta la salud a sus trabajadores y la paga en un solo pago por
// período: un encabezado con un renglón por trabajador (RF-SAL-11/12).
// "Pendiente" no se guarda: es el trabajador que le tocaba a la feria en ese
// período y no tiene renglón vigente. Anular marca encabezado y renglones como
// anulados y el período vuelve a quedar pendiente; nada se borra.
//
// OJO: índice único parcial en la migración (un renglón vigente por trabajador
// y período, RN-10). Prisma no lo expresa. Ver 20260914000000_pago_salud_feria.

model PeriodoSalud {
  id           Int              @id @default(autoincrement())
  tipo         TipoPeriodoSalud
  anio         Int
  // Mes (1-12) o semana ISO (1-53), según el tipo
  numero       Int
  fecha_inicio DateTime         @db.Date
  fecha_fin    DateTime         @db.Date
  created_at   DateTime         @default(now())

  // Relaciones
  pagos_desde PagoSaludFeria[]      @relation("PagoSaludDesde")
  pagos_hasta PagoSaludFeria[]      @relation("PagoSaludHasta")
  detalles    PagoSaludTrabajador[]

  @@unique([tipo, anio, numero])
  @@map("periodos_salud")
}

model PagoSaludFeria {
  id                    Int             @id @default(autoincrement())
  feria_id              Int
  // Primer y último período que cubre el pago (pueden ser el mismo)
  periodo_id            Int
  periodo_hasta_id      Int
  cantidad_periodos     Int             @default(1)
  fecha_pago            DateTime        @db.Date
  cantidad_trabajadores Int
  // Tarifa y tasa del momento: cambiar el parámetro no altera pagos hechos
  tarifa_usd            Decimal         @db.Decimal(10, 2)
  monto_esperado_usd    Decimal         @db.Decimal(12, 2)
  tasa_cambio           Decimal         @db.Decimal(10, 4)
  monto_esperado_bs     Decimal         @db.Decimal(14, 2)
  moneda                Moneda          @default(BS)
  monto_recibido        Decimal         @db.Decimal(14, 2)
  metodo_pago           String          @db.VarChar(30)
  referencia            String?         @db.VarChar(60)
  observaciones         String?         @db.Text
  estado                EstadoPagoSalud @default(vigente)
  created_by            Int
  created_at            DateTime        @default(now())
  anulado_por           Int?
  fecha_anulacion       DateTime?
  motivo_anulacion      String?         @db.Text

  // Relaciones
  feria         Ubicacion             @relation(fields: [feria_id], references: [id])
  periodo       PeriodoSalud          @relation("PagoSaludDesde", fields: [periodo_id], references: [id])
  periodo_hasta PeriodoSalud          @relation("PagoSaludHasta", fields: [periodo_hasta_id], references: [id])
  detalles      PagoSaludTrabajador[]

  @@index([feria_id, periodo_id])
  @@index([referencia])
  @@index([estado])
  @@map("pagos_salud_feria")
}

model PagoSaludTrabajador {
  id            Int             @id @default(autoincrement())
  pago_id       Int
  trabajador_id Int
  // Feria del trabajador EN ESE PERÍODO, guardada: un traslado posterior no la cambia (RN-14)
  feria_id      Int
  periodo_id    Int
  monto_usd     Decimal         @db.Decimal(10, 2)
  estado        EstadoPagoSalud @default(vigente)
  created_at    DateTime        @default(now())

  // Relaciones
  pago       PagoSaludFeria  @relation(fields: [pago_id], references: [id])
  trabajador SocioTrabajador @relation(fields: [trabajador_id], references: [id])
  feria      Ubicacion       @relation(fields: [feria_id], references: [id])
  periodo    PeriodoSalud    @relation(fields: [periodo_id], references: [id])

  @@index([trabajador_id, periodo_id])
  @@index([pago_id])
  @@index([periodo_id, feria_id])
  @@map("pagos_salud_trabajador")
}

enum TipoPeriodoSalud {
  mensual
  semanal
}

enum EstadoPagoSalud {
  vigente
  anulado
}

// ============================================
// UBICACIONES/SUCURSALES
// ============================================

model Ubicacion {
  id         Int      @id @default(autoincrement())
  codigo     String   @unique @db.VarChar(10)
  nombre     String   @db.VarChar(100)
  direccion  String?  @db.Text
  telefono   String?  @db.VarChar(20)
  estado     Boolean  @default(true)
  created_at DateTime @default(now())

  // Ficha de la feria (RF-FER-01)
  ubicacion     String? @db.VarChar(150)
  responsable   String? @db.VarChar(100)
  observaciones String? @db.Text

  // Relaciones
  socios            Socio[]
  trabajadores      TrabajadorFeria[]
  pagos_salud       PagoSaludFeria[]
  detalles_salud    PagoSaludTrabajador[]
  movimientos_salud MovimientoSalud[]
  asambleas         Asamblea[]
  colectas          Colecta[]

  @@map("ubicaciones")
}

// ============================================
// AHORRO
// ============================================

model TipoCuentaAhorro {
  id          Int      @id @default(autoincrement())
  codigo      String   @unique @db.VarChar(10)
  nombre      String   @db.VarChar(100)
  descripcion String?  @db.Text
  estado      Boolean  @default(true)
  created_at  DateTime @default(now())

  // Relaciones
  cuentas CuentaAhorro[]

  @@map("tipos_cuenta_ahorro")
}

model CuentaAhorro {
  id                  Int      @id @default(autoincrement())
  socio_id            Int
  tipo_cuenta_id      Int
  numero_cuenta       String   @unique @db.VarChar(20)
  saldo_usd           Decimal  @default(0) @db.Decimal(12, 2)
  saldo_bs            Decimal  @default(0) @db.Decimal(12, 2)
  monto_bloqueado_usd Decimal  @default(0) @db.Decimal(12, 2) // Por fianzas
  monto_bloqueado_bs  Decimal  @default(0) @db.Decimal(12, 2)
  estado              Boolean  @default(true)
  fecha_apertura      DateTime @default(now()) @db.Date
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  // Relaciones
  socio       Socio              @relation(fields: [socio_id], references: [id], onDelete: Cascade)
  tipo_cuenta TipoCuentaAhorro   @relation(fields: [tipo_cuenta_id], references: [id])
  movimientos MovimientoAhorro[]

  @@index([socio_id])
  @@index([numero_cuenta])
  @@map("cuentas_ahorro")
}

model MovimientoAhorro {
  id                 Int      @id @default(autoincrement())
  cuenta_id          Int
  tipo_movimiento    String   @db.VarChar(20) // deposito, retiro
  monto_usd          Decimal  @db.Decimal(12, 2)
  monto_bs           Decimal  @db.Decimal(12, 2)
  tasa_cambio        Decimal  @db.Decimal(10, 4) // Tasa en el momento de la transacción
  saldo_anterior_usd Decimal  @db.Decimal(12, 2)
  saldo_nuevo_usd    Decimal  @db.Decimal(12, 2)
  // Saldo en bolivares tras el movimiento. Se guarda en vez de derivarlo de
  // los dolares por la tasa: ese ida y vuelta pierde centimos y la libreta
  // termina mostrando un saldo que no cuadra con el de la cuenta.
  saldo_nuevo_bs     Decimal? @db.Decimal(12, 2)
  // Moneda en que el socio entrego el dinero. La cuenta lleva ambos saldos,
  // pero el cuadre de caja necesita saber si entraron bolivares o divisas.
  moneda             Moneda   @default(BS)
  // Presencial o cajero digital: el cliente pidio diferenciarlos (req. 4)
  canal              String   @default("presencial") @db.VarChar(20)
  concepto           String?  @db.Text
  referencia         String?  @db.VarChar(50)
  fecha_movimiento   DateTime @default(now())
  created_at         DateTime @default(now())

  // Relaciones
  cuenta CuentaAhorro @relation(fields: [cuenta_id], references: [id])

  @@index([cuenta_id])
  @@index([fecha_movimiento])
  @@map("movimientos_ahorro")
}

// ============================================
// FUNERARIA
// ============================================

model TipoAcuerdoFuneraria {
  id         Int      @id @default(autoincrement())
  codigo     String   @unique @db.VarChar(10)
  nombre     String   @db.VarChar(100)
  monto_usd  Decimal  @db.Decimal(10, 2)
  ubicacion  String?  @db.VarChar(100) // Código de sucursal si aplica
  estado     Boolean  @default(true)
  created_at DateTime @default(now())

  // Relaciones
  acuerdos AcuerdoFuneraria[]

  @@map("tipos_acuerdo_funeraria")
}

model AcuerdoFuneraria {
  id              Int            @id @default(autoincrement())
  beneficiario_id Int
  tipo_acuerdo_id Int
  numero_acuerdo  String?        @unique @db.VarChar(20)
  numero_contrato String?        @db.VarChar(20)
  estado          EstadoServicio @default(activo)

  // COBERTURA: hasta que (ano, semana) quedo pagado el servicio.
  //
  // Es lo que el cliente pide ver y lo unico que permite adelantar semanas y
  // cruzar diciembre-enero. `semanas_sin_pago` pasa a ser un valor DERIVADO de
  // la cobertura contra la semana actual; se mantiene poblado porque lo leen
  // los modulos de funeraria, salud y los reportes.
  ano_pagado_hasta    Int?
  semana_pagada_hasta Int?
  // Cuando se cobro, que es distinto de hasta cuando quedo cubierto
  fecha_ultimo_pago   DateTime?

  semanas_sin_pago Int       @default(0)
  fecha_suspension DateTime? @db.Date
  fecha_retiro     DateTime? @db.Date
  motivo_retiro    String?   @db.Text
  fecha_inicio     DateTime  @default(now()) @db.Date
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  // Relaciones
  beneficiario Beneficiario          @relation(fields: [beneficiario_id], references: [id], onDelete: Cascade)
  tipo_acuerdo TipoAcuerdoFuneraria  @relation(fields: [tipo_acuerdo_id], references: [id])
  movimientos  MovimientoFuneraria[]

  @@index([beneficiario_id])
  @@index([estado])
  @@index([numero_acuerdo])
  @@map("acuerdos_funeraria")
}

model MovimientoFuneraria {
  id               Int      @id @default(autoincrement())
  acuerdo_id       Int
  tipo_movimiento  String   @db.VarChar(20) // pago, suspension, reactivacion
  monto_usd        Decimal  @db.Decimal(10, 2)
  monto_bs         Decimal  @db.Decimal(10, 2)
  tasa_cambio      Decimal  @db.Decimal(10, 4)
  semanas_pagadas  Int? // Cuántas semanas cubre este pago
  // Hasta que (ano, semana) dejo cubierto el acuerdo ESTE movimiento. Es lo que
  // sale en los reportes y en el archivo para la funeraria externa.
  ano_cobertura    Int?
  semana_cobertura Int?
  // De que colecta vino, y si ya fue reversado. Sin esto no hay forma de saber
  // que un pago quedo sin efecto: el reverso crea un movimiento espejo, pero
  // el pago original seguia figurando como vigente.
  colecta_id       Int?
  reversado        Boolean  @default(false)
  concepto         String?  @db.Text
  fecha_movimiento DateTime @default(now())
  created_at       DateTime @default(now())

  // Relaciones
  acuerdo AcuerdoFuneraria @relation(fields: [acuerdo_id], references: [id])

  @@index([acuerdo_id])
  @@index([fecha_movimiento])
  @@index([colecta_id])
  @@map("movimientos_funeraria")
}

// ============================================
// SALUD
// ============================================

model TipoAcuerdoSalud {
  id         Int      @id @default(autoincrement())
  codigo     String   @unique @db.VarChar(10)
  nombre     String   @db.VarChar(100)
  monto_usd  Decimal  @db.Decimal(10, 2)
  estado     Boolean  @default(true)
  created_at DateTime @default(now())

  // Relaciones
  acuerdos AcuerdoSalud[]

  @@map("tipos_acuerdo_salud")
}

model AcuerdoSalud {
  id              Int            @id @default(autoincrement())
  beneficiario_id Int
  tipo_acuerdo_id Int
  numero_acuerdo  String?        @db.VarChar(20) // Compartido por hasta 9 personas (titular + 8 beneficiarios)
  numero_contrato String?        @db.VarChar(20)
  estado          EstadoServicio @default(activo)

  // Cobertura pagada: ver la nota en AcuerdoFuneraria
  ano_pagado_hasta    Int?
  semana_pagada_hasta Int?
  fecha_ultimo_pago   DateTime?

  semanas_sin_pago Int       @default(0)
  fecha_suspension DateTime? @db.Date
  fecha_retiro     DateTime? @db.Date
  motivo_retiro    String?   @db.Text // 'Socio' | 'Voluntario' | 'Art. 5'
  fecha_inicio     DateTime  @default(now()) @db.Date
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  // Relaciones
  beneficiario Beneficiario      @relation(fields: [beneficiario_id], references: [id], onDelete: Cascade)
  tipo_acuerdo TipoAcuerdoSalud  @relation(fields: [tipo_acuerdo_id], references: [id])
  movimientos  MovimientoSalud[]

  @@unique([numero_acuerdo, beneficiario_id])
  @@index([beneficiario_id])
  @@index([estado])
  @@index([numero_acuerdo])
  @@map("acuerdos_salud")
}

model MovimientoSalud {
  id               Int      @id @default(autoincrement())
  acuerdo_id       Int
  tipo_movimiento  String   @db.VarChar(20) // pago, suspension, reactivacion
  monto_usd        Decimal  @db.Decimal(10, 2)
  monto_bs         Decimal  @db.Decimal(10, 2)
  tasa_cambio      Decimal  @db.Decimal(10, 4)
  semanas_pagadas  Int?
  // Hasta que (ano, semana) dejo cubierto el acuerdo ESTE movimiento
  ano_cobertura    Int?
  semana_cobertura Int?
  // De que colecta vino, y si ya fue reversado (ver nota en MovimientoFuneraria)
  colecta_id       Int?
  reversado        Boolean  @default(false)
  numero_recibo    String?  @db.VarChar(30)
  ubicacion_id     Int?
  concepto         String?  @db.Text
  fecha_movimiento DateTime @default(now())
  created_at       DateTime @default(now())

  // Relaciones
  acuerdo   AcuerdoSalud @relation(fields: [acuerdo_id], references: [id])
  ubicacion Ubicacion?   @relation(fields: [ubicacion_id], references: [id])

  @@index([acuerdo_id])
  @@index([fecha_movimiento])
  @@index([numero_recibo])
  @@index([colecta_id])
  @@map("movimientos_salud")
}

enum EstadoServicio {
  activo
  suspendido
  retirado
}

// ============================================
// PRÉSTAMOS
// ============================================

model TipoPrestamo {
  id                   Int      @id @default(autoincrement())
  codigo               String   @unique @db.VarChar(10)
  nombre               String   @db.VarChar(100)
  descripcion          String?  @db.Text
  tasa_interes_anual   Decimal  @db.Decimal(5, 2) // Ej: 12.50 (12.50%)
  tasa_mora_mensual    Decimal  @default(2.00) @db.Decimal(5, 2)
  plazo_maximo_semanas Int      @default(52)
  requiere_fiadores    Boolean  @default(true)
  // Moneda en que se otorga esta categoria. En el sistema actual es una
  // propiedad del TIPO ("linea blanca" se da en divisas, "efectivo" en
  // bolivares), lo que resuelve la duda de la reunion: divisa no es una
  // categoria de prestamo aparte, es la moneda de la categoria.
  moneda               Moneda   @default(BS)
  estado               Boolean  @default(true)
  created_at           DateTime @default(now())

  // Relaciones
  prestamos Prestamo[]

  @@map("tipos_prestamo")
}

model Prestamo {
  id                  Int            @id @default(autoincrement())
  socio_id            Int
  tipo_prestamo_id    Int
  numero_prestamo     String         @unique @db.VarChar(20)
  monto_original_usd  Decimal        @db.Decimal(12, 2)
  monto_original_bs   Decimal        @db.Decimal(12, 2)
  tasa_cambio_inicial Decimal        @db.Decimal(10, 4)
  tasa_interes        Decimal        @db.Decimal(5, 2)
  plazo_semanas       Int
  cuota_semanal_usd   Decimal        @db.Decimal(10, 2)
  cuota_semanal_bs    Decimal        @db.Decimal(10, 2)
  saldo_capital_usd   Decimal        @db.Decimal(12, 2)
  saldo_capital_bs    Decimal        @db.Decimal(12, 2)
  saldo_interes_usd   Decimal        @default(0) @db.Decimal(12, 2)
  saldo_interes_bs    Decimal        @default(0) @db.Decimal(12, 2)
  saldo_mora_usd      Decimal        @default(0) @db.Decimal(12, 2)
  saldo_mora_bs       Decimal        @default(0) @db.Decimal(12, 2)
  estado              EstadoPrestamo @default(activo)
  fecha_desembolso    DateTime       @db.Date
  fecha_vencimiento   DateTime       @db.Date
  // El cliente ve hoy la fecha de otorgamiento y tiene que abrir otra pantalla
  // para saber cuando pago por ultima vez (req. 5 de la reunion)
  fecha_ultimo_abono  DateTime?

  // Moneda en que se otorgo. El sistema actual la lleva como un campo aparte
  // ("Bolivares" / "Divisas") de la CATEGORIA (efectivo, linea blanca, gastos
  // medicos), lo que responde la duda de la reunion: divisa es una modalidad,
  // no una categoria de prestamo.
  moneda     Moneda   @default(BS)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relaciones
  socio         Socio           @relation("SocioPrestamo", fields: [socio_id], references: [id])
  tipo_prestamo TipoPrestamo    @relation(fields: [tipo_prestamo_id], references: [id])
  fiadores      Fiador[]
  plan_pagos    PlanPago[]
  abonos        AbonoPrestamo[]

  @@index([socio_id])
  @@index([numero_prestamo])
  @@index([estado])
  @@map("prestamos")
}

model Fiador {
  id                    Int          @id @default(autoincrement())
  prestamo_id           Int
  socio_id              Int
  monto_garantizado_usd Decimal      @db.Decimal(12, 2)
  monto_garantizado_bs  Decimal      @db.Decimal(12, 2)
  monto_bloqueado_usd   Decimal      @db.Decimal(12, 2) // En su ahorro
  monto_bloqueado_bs    Decimal      @db.Decimal(12, 2)
  estado                EstadoFiador @default(activo)
  fecha_liberacion      DateTime?    @db.Date
  created_at            DateTime     @default(now())

  // Relaciones
  prestamo Prestamo @relation(fields: [prestamo_id], references: [id])
  socio    Socio    @relation(fields: [socio_id], references: [id])

  @@index([prestamo_id])
  @@index([socio_id])
  @@map("fiadores")
}

model PlanPago {
  id                Int         @id @default(autoincrement())
  prestamo_id       Int
  numero_cuota      Int
  fecha_vencimiento DateTime    @db.Date
  monto_capital_usd Decimal     @db.Decimal(10, 2)
  monto_capital_bs  Decimal     @db.Decimal(10, 2)
  monto_interes_usd Decimal     @db.Decimal(10, 2)
  monto_interes_bs  Decimal     @db.Decimal(10, 2)
  monto_total_usd   Decimal     @db.Decimal(10, 2)
  monto_total_bs    Decimal     @db.Decimal(10, 2)
  estado            EstadoCuota @default(pendiente)
  fecha_pago        DateTime?   @db.Date
  created_at        DateTime    @default(now())

  // Relaciones
  prestamo Prestamo @relation(fields: [prestamo_id], references: [id])

  @@index([prestamo_id])
  @@index([fecha_vencimiento])
  @@map("plan_pagos")
}

model AbonoPrestamo {
  id                   Int     @id @default(autoincrement())
  prestamo_id          Int
  monto_usd            Decimal @db.Decimal(10, 2)
  monto_bs             Decimal @db.Decimal(10, 2)
  tasa_cambio          Decimal @db.Decimal(10, 4)
  aplicado_capital_usd Decimal @db.Decimal(10, 2)
  aplicado_capital_bs  Decimal @db.Decimal(10, 2)
  aplicado_interes_usd Decimal @db.Decimal(10, 2)
  aplicado_interes_bs  Decimal @db.Decimal(10, 2)
  aplicado_mora_usd    Decimal @default(0) @db.Decimal(10, 2)
  aplicado_mora_bs     Decimal @default(0) @db.Decimal(10, 2)
  concepto             String? @db.Text

  // Colecta que lo cobró, si vino de la caja. Esos abonos se reversan junto
  // con su colecta: reversarlos sueltos descuadraría el cierre de caja.
  colecta_id Int?

  // Reverso del abono: no se borra, se marca y se deja rastro (req. 6)
  reversado      Boolean   @default(false)
  fecha_reverso  DateTime?
  motivo_reverso String?   @db.Text
  reversado_por  Int?

  fecha_abono DateTime @default(now())
  created_at  DateTime @default(now())

  // Relaciones
  prestamo Prestamo @relation(fields: [prestamo_id], references: [id])

  @@index([prestamo_id])
  @@index([fecha_abono])
  @@index([colecta_id])
  @@map("abonos_prestamo")
}

enum EstadoPrestamo {
  activo
  saldado
  moroso
  refinanciado
  cancelado
}

enum EstadoFiador {
  activo
  liberado
}

enum EstadoCuota {
  pendiente
  pagada
  vencida
}

// ============================================
// COLECTA / CAJA
// ============================================

model Colecta {
  id                Int      @id @default(autoincrement())
  socio_id          Int
  usuario_id        Int
  semana_colecta_id Int? // Relación con la semana de colecta
  fecha_colecta     DateTime @default(now())
  monto_total_usd   Decimal  @db.Decimal(10, 2)
  monto_total_bs    Decimal  @db.Decimal(10, 2)
  tasa_cambio       Decimal  @db.Decimal(10, 4)
  observaciones     String?  @db.Text

  // Periodo cobrado. En el sistema viejo son los campos sem_cob / ano_cob del
  // formulario: la semana NO es una entidad previa que haya que crear.
  semanas_cobradas Int     @default(1)
  semana_cobro     Int?
  ano_cobro        Int?
  referencia       String? @db.VarChar(50)

  // Oficina y canal: el cuadre se pide por oficina, por colector y por canal,
  // ademas del consolidado general (req. 9)
  ubicacion_id Int?
  canal        String @default("presencial") @db.VarChar(20)

  // Tarifas vigentes al cobrar. Se guardan para que un cambio posterior de
  // parametros no altere transacciones historicas.
  tarifa_ahorro_usd    Decimal? @db.Decimal(10, 4)
  tarifa_funeraria_usd Decimal? @db.Decimal(10, 4)
  tarifa_salud_usd     Decimal? @db.Decimal(10, 4)

  // Reverso: la colecta no se borra, se marca. Deja rastro de quien y por que.
  reversada      Boolean   @default(false)
  fecha_reverso  DateTime?
  motivo_reverso String?   @db.Text
  reversada_por  Int?

  created_at DateTime @default(now())

  // Relaciones
  socio          Socio            @relation(fields: [socio_id], references: [id])
  usuario        Usuario          @relation("UsuarioColecta", fields: [usuario_id], references: [id])
  semana_colecta SemanaColecta?   @relation(fields: [semana_colecta_id], references: [id])
  ubicacion      Ubicacion?       @relation(fields: [ubicacion_id], references: [id])
  detalles       DetalleColecta[]

  @@index([ubicacion_id])
  @@index([socio_id])
  @@index([fecha_colecta])
  @@index([usuario_id])
  @@index([semana_colecta_id])
  @@index([reversada])
  @@map("colecta")
}

model DetalleColecta {
  id            Int     @id @default(autoincrement())
  colecta_id    Int
  servicio      String  @db.VarChar(20) // ahorro, funeraria, salud, prestamo
  referencia_id Int? // ID del acuerdo o préstamo
  monto_usd     Decimal @db.Decimal(10, 2)
  monto_bs      Decimal @db.Decimal(10, 2)

  // Cuantas semanas cubrio ESTE renglon y a que tarifa unitaria. Guardarlo aqui
  // hace el reverso exacto: hoy hay que adivinarlo buscando "el ultimo
  // movimiento del acuerdo", que puede no ser el de esta colecta.
  semanas             Int?
  tarifa_unitaria_usd Decimal? @db.Decimal(10, 4)
  // Cargo por reactivar un acuerdo suspendido: suma al total pero NO cubre semanas
  es_reintegro        Boolean  @default(false)

  // Cobertura del acuerdo antes y despues del renglon. El reverso devuelve
  // exactamente a `_antes`, sin recalcular nada.
  cobertura_ano_antes      Int?
  cobertura_semana_antes   Int?
  cobertura_ano_despues    Int?
  cobertura_semana_despues Int?

  concepto   String?  @db.Text
  created_at DateTime @default(now())

  // Relaciones
  colecta Colecta @relation(fields: [colecta_id], references: [id], onDelete: Cascade)

  @@index([colecta_id])
  @@map("detalle_colecta")
}

model CierreCaja {
  id                     Int      @id @default(autoincrement())
  usuario_id             Int
  ubicacion_id           Int?
  fecha_cierre           DateTime @default(now())
  fecha_inicio_operacion DateTime @db.Date
  fecha_fin_operacion    DateTime @db.Date

  // Totales en USD
  total_ahorro_usd    Decimal @default(0) @db.Decimal(12, 2)
  total_funeraria_usd Decimal @default(0) @db.Decimal(12, 2)
  total_salud_usd     Decimal @default(0) @db.Decimal(12, 2)
  total_prestamos_usd Decimal @default(0) @db.Decimal(12, 2)
  total_general_usd   Decimal @default(0) @db.Decimal(12, 2)

  // Totales en Bs
  total_ahorro_bs    Decimal @default(0) @db.Decimal(12, 2)
  total_funeraria_bs Decimal @default(0) @db.Decimal(12, 2)
  total_salud_bs     Decimal @default(0) @db.Decimal(12, 2)
  total_prestamos_bs Decimal @default(0) @db.Decimal(12, 2)
  total_general_bs   Decimal @default(0) @db.Decimal(12, 2)

  cantidad_transacciones Int      @default(0)
  observaciones          String?  @db.Text
  created_at             DateTime @default(now())

  // Relaciones
  usuario Usuario @relation(fields: [usuario_id], references: [id])

  @@index([usuario_id])
  @@index([fecha_cierre])
  @@map("cierre_caja")
}

// ============================================
// BÓVEDA
// ============================================

model MovimientoBoveda {
  id               Int                  @id @default(autoincrement())
  tipo_movimiento  TipoMovimientoBoveda
  moneda           Moneda
  monto            Decimal              @db.Decimal(12, 2)
  concepto         String               @db.Text
  usuario_id       Int
  fecha_movimiento DateTime             @default(now())
  created_at       DateTime             @default(now())

  // Relaciones
  usuario Usuario @relation(fields: [usuario_id], references: [id])

  @@index([fecha_movimiento])
  @@index([moneda])
  @@map("movimientos_boveda")
}

enum TipoMovimientoBoveda {
  entrada
  salida
}

enum Moneda {
  USD
  BS
}

// ============================================
// CAJERO DIGITAL
// ============================================

model UsuarioDigital {
  id            Int       @id @default(autoincrement())
  socio_id      Int       @unique
  username      String    @unique @db.VarChar(50)
  password_hash String    @db.VarChar(255)
  estado        Boolean   @default(true)
  ultimo_acceso DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  // Relaciones
  socio     Socio     @relation(fields: [socio_id], references: [id], onDelete: Cascade)
  pagos_web PagoWeb[]

  @@map("usuarios_digitales")
}

model PagoWeb {
  id                  Int           @id @default(autoincrement())
  usuario_digital_id  Int
  monto_usd           Decimal       @db.Decimal(10, 2)
  monto_bs            Decimal       @db.Decimal(10, 2)
  referencia_bancaria String        @db.VarChar(100)
  banco               String        @db.VarChar(100)
  fecha_pago          DateTime      @db.Date
  estado              EstadoPagoWeb @default(pendiente)
  fecha_conciliacion  DateTime?     @db.Date
  observaciones       String?       @db.Text
  created_at          DateTime      @default(now())
  updated_at          DateTime      @updatedAt

  // Relaciones
  usuario_digital UsuarioDigital @relation(fields: [usuario_digital_id], references: [id])

  @@index([usuario_digital_id])
  @@index([estado])
  @@index([fecha_pago])
  @@map("pagos_web")
}

enum EstadoPagoWeb {
  pendiente
  conciliado
  rechazado
}

// ============================================
// PARÁMETROS DEL SISTEMA
// ============================================

model ParametroSistema {
  id              Int      @id @default(autoincrement())
  clave           String   @unique @db.VarChar(50)
  valor           String   @db.Text
  descripcion     String?  @db.Text
  tipo_dato       String   @default("string") @db.VarChar(20) // string, number, boolean, json
  actualizado_por Int?
  updated_at      DateTime @updatedAt
  created_at      DateTime @default(now())

  @@map("parametros_sistema")
}

model HistoricoTasaCambio {
  id              Int      @id @default(autoincrement())
  tasa            Decimal  @db.Decimal(10, 4)
  fecha_vigencia  DateTime @db.Date
  actualizado_por Int?
  created_at      DateTime @default(now())

  @@index([fecha_vigencia])
  @@map("historico_tasa_cambio")
}

// ============================================
// SEMANAS DE COLECTA (GESTIÓN TASA SEMANAL)
// ============================================

model SemanaColecta {
  id              Int      @id @default(autoincrement())
  semana          Int // Semana del año (1-52)
  ano             Int // Año
  tasa_usd_bs     Decimal  @db.Decimal(10, 4) // Tasa semanal USD/Bs (ej: 700.22)
  meta_ahorro     Decimal? @default(0) @db.Decimal(15, 2) // Meta de colecta Ahorro
  meta_funeraria  Decimal? @default(0) @db.Decimal(15, 2) // Meta de colecta Funeraria
  meta_salud      Decimal? @default(0) @db.Decimal(15, 2) // Meta de colecta Salud
  fecha_inicio    DateTime @db.Date // Fecha de inicio de la semana
  fecha_fin       DateTime @db.Date // Fecha de fin de la semana
  estado          Boolean  @default(true) // Activa/Inactiva
  actualizado_por Int?
  updated_at      DateTime @updatedAt
  created_at      DateTime @default(now())

  // Relaciones
  colectas Colecta[] // Colectas realizadas en esta semana

  @@unique([semana, ano])
  @@index([fecha_inicio, fecha_fin])
  @@index([ano, semana])
  @@map("semanas_colecta")
}

// ============================================
// ASAMBLEAS Y ASISTENCIA
// ============================================

model Asamblea {
  id           Int          @id @default(autoincrement())
  titulo       String       @db.VarChar(150)
  tipo         TipoAsamblea @default(ordinaria)
  fecha        DateTime     @db.Date
  ano          Int // Denormalizado desde fecha: el reporte de inasistentes es anual
  ubicacion_id Int? // Feria/sector; obligatorio en la practica para las sectoriales
  descripcion  String?      @db.Text
  estado       Boolean      @default(true) // Permite anular una asamblea sin borrar su historial
  creado_por   Int?
  created_at   DateTime     @default(now())
  updated_at   DateTime     @updatedAt

  // Relaciones
  ubicacion   Ubicacion?           @relation(fields: [ubicacion_id], references: [id])
  asistencias AsistenciaAsamblea[]

  @@index([ano])
  @@index([fecha])
  @@index([ubicacion_id])
  @@map("asambleas")
}

model AsistenciaAsamblea {
  id             Int      @id @default(autoincrement())
  asamblea_id    Int
  socio_id       Int
  observacion    String?  @db.Text
  registrado_por Int?
  created_at     DateTime @default(now())

  // Relaciones
  asamblea Asamblea @relation(fields: [asamblea_id], references: [id], onDelete: Cascade)
  socio    Socio    @relation(fields: [socio_id], references: [id], onDelete: Cascade)

  // Un socio se registra una sola vez por asamblea
  @@unique([asamblea_id, socio_id])
  @@index([socio_id])
  @@map("asistencias_asamblea")
}

enum TipoAsamblea {
  ordinaria
  extraordinaria
  sectorial
}

// ============================================
// AUDITORÍA
// ============================================

model AuditLog {
  id            Int      @id @default(autoincrement())
  usuario_id    Int?
  accion        String   @db.VarChar(50) // CREATE, UPDATE, DELETE, LOGIN, etc.
  modulo        String   @db.VarChar(50) // socios, prestamos, colecta, etc.
  registro_id   Int? // ID del registro afectado
  datos_antes   Json? // Estado antes del cambio
  datos_despues Json? // Estado después del cambio
  ip_address    String?  @db.VarChar(45) // IPv4 o IPv6
  user_agent    String?  @db.Text
  created_at    DateTime @default(now())

  // Relaciones
  usuario Usuario? @relation(fields: [usuario_id], references: [id])

  @@index([usuario_id])
  @@index([accion])
  @@index([modulo])
  @@index([created_at])
  @@map("audit_log")
}
